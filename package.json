{
  "name": "fingence-finance-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check:server-boundary": "node scripts/verify-server-boundary.mjs",
    "test:ingestion": "vitest run tests/ingestion",
    "test:analytics": "vitest run tests/analytics.test.ts tests/analytics-adapter.test.ts tests/integration/ingestion-analytics.test.ts",
    "test:persistence": "vitest run tests/persistence tests/integration/grouped-consultation.test.ts",
    "test:security": "vitest run tests/security",
    "phase2:ingest": "node --conditions=react-server scripts/phase2.mjs",
    "demo:persistence": "vitest run tests/integration/grouped-consultation.test.ts --reporter=verbose",
    "ai:doctor": "node --conditions=react-server scripts/ai-cli.mjs doctor",
    "ai:extract": "node --conditions=react-server scripts/ai-cli.mjs extract",
    "ai:evaluate": "node --conditions=react-server scripts/ai-cli.mjs evaluate",
    "ai:benchmark": ".venv-ai/bin/python scripts/ai-benchmark.py",
    "ai:demo": "FINGENCE_AI_LOCAL=1 FINGENCE_EXTRACTOR=docling FINGENCE_AI_PYTHON=.venv-ai/bin/python next dev --hostname 127.0.0.1 --port 3103",
    "test:ai": "vitest run tests/ai-ingestion",
    "demo:financial:local": "node scripts/local-financial-demo.mjs",
    "m2:account": "node --conditions=react-server scripts/m2.mjs account",
    "m2:dev": "node scripts/m2.mjs serve",
    "m3:dev": "node scripts/m3.mjs serve",
    "m3:account": "node --conditions=react-server scripts/m3.mjs account",
    "m3:organization": "node --conditions=react-server scripts/m3.mjs organization",
    "m4:dev": "node scripts/m4.mjs serve",
    "m4:account": "node --conditions=react-server scripts/m4.mjs account",
    "m4:prepare": "node --conditions=react-server scripts/m4.mjs prepare",
    "m4:dispatch": "node --conditions=react-server scripts/m4.mjs dispatch-one",
    "m4:evaluate": "node --conditions=react-server scripts/m4-evaluate.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "^1.38.0",
    "next": "16.4.1",
    "openai": "7.39.0",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  }
}
